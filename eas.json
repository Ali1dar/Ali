{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "channel": "production",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true"
      }
    },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease"
      },
      "env": {
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true",
        "ANDROID_COMPILE_SDK": "35",
        "ANDROID_TARGET_SDK": "35",
        "ANDROID_BUILD_TOOLS": "35.0.0"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
