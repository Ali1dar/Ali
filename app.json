{
  "expo": {
    "name": "دليلك الدوائي",
    "slug": "dlylk-aldwaey",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#00796b"
    },
    "notification": {
      "icon": "./assets/adaptive-icon.png",
      "color": "#00796b",
      "androidMode": "default",
      "androidCollapsedTitle": "دليلك الدوائي"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#00796b"
      },
      "package": "com.dalilakedawai",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "@react-native-firebase/app",
      [
        "@react-native-firebase/messaging",
        {
          "ios": {
            "permissions": [
              "DISPLAY_NOTIFICATIONS",
              "SOUND",
              "BADGE",
              "ALERT"
            ]
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "يرجى السماح بالوصول لمعرض الصور"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "يرجى السماح بتحديد الموقع للبحث عن الصيدليات القريبة"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "يرجى السماح باستخدام الميكروفون لإرسال رسائل صوتية"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "41c1978d-89f2-46ff-80f1-0401f1eabe23"
      }
    },
    "owner": "ali07823"
  }
}
