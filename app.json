{
  "expo": {
    "name": "دليلك الدوائي",
    "slug": "dalilakedawai",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#00796b"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#00796b"
      },
      "package": "com.dalilakedawai",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "VIBRATE",
        "MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "يرجى السماح بالوصول لمعرض الصور واختيار صور الأدوية والوصفات."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "يرجى السماح بتحديد الموقع لتسهيل وصول المندوب إليك."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "يرجى السماح باستخدام الميكروفون لإرسال الرسائل الصوتية داخل المحادثة."
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "cd4274e0-0643-4f70-a7f3-dc3958369a4d"
      }
    },
    "ios": {
      "bundleIdentifier": "com.dalilakedawai"
    }
  }
}
