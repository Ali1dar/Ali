{
  "expo": {
    "name": "دليلك الدوائي",
    "slug": "dlylk-aldwaey",
    "scheme": "dalilakedawai",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#00796b"
    },
    "updates": {
      "url": "https://u.expo.dev/17bbadaf-8774-407f-b281-78bc5deef012"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "android": {
      "versionCode": 9,
      "targetSdkVersion": 35,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#00796b"
      },
      "package": "com.dalilakedawai",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-image-picker",
        {
          "photosPermission": "يرجى السماح بالوصول لمعرض الصور"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "يرجى السماح بتحديد الموقع للبحث عن الصيدليات القريبة"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "يرجى السماح باستخدام الميكروفون لإرسال رسائل صوتية"
        }
      ],
      "expo-updates",
      "expo-font",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "3def34ff-298b-413b-9c7b-1e8fd27bf569"
      }
    },
    "owner": "alidli"
  }
}
